<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the files the installer copies to Program
     Files (build/app, uploaded as a GitHub artifact, which is a zip). Paste this into the
     "app" artifact configuration of the tablet-deck project in SignPath. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="TabletDeck.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="TabletDeckServer.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="native/keysender.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="native/voice.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
